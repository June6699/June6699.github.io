# 复制为 .env 或直接在 shell 中 export（勿将含真实值的 .env 提交到 git）
# GitHub Actions 请在仓库 Settings → Secrets 中配置同名变量。
# run_server.bat 会忽略「值为空」的行，避免 HUGO_MOMENTS_PASSWORD_HASH= 之类清空你在 Windows 用户变量里已配置的值。

GITALK_CLIENT_ID=
GITALK_CLIENT_SECRET=
# 动态区口令：推荐只存 SHA-256 哈希，不存明文
# 生成方式（PowerShell）：
# $bytes = [System.Text.Encoding]::UTF8.GetBytes("你的密码")
# -join ([System.Security.Cryptography.SHA256]::Create().ComputeHash($bytes) | ForEach-Object { $_.ToString("x2") })
HUGO_MOMENTS_PASSWORD_HASH=
HUGO_MOMENTS_RECOVERY_EMAIL=
# 服务器同步（GitHub Actions）
# 注意：这里写真实主机/IP，不要写本机 ssh 别名 june-server
SERVER_SSH_HOST=
SERVER_SSH_PORT=22
SERVER_SSH_USER=
SERVER_DEPLOY_PATH=/projects/June6699.github.io/public
SERVER_SSH_PRIVATE_KEY=
SERVER_SSH_KNOWN_HOSTS=
# 可选覆盖 hugo.toml 中的 gitalk 项：
# GITALK_REPO=
# GITALK_OWNER=
# GITALK_ADMIN=
# GITALK_REDIRECT_URI=
